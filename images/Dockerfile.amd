# AMD (7900 XTX / gfx1101) 课程镜像 — hami-learning-cloud
# 基线: rocm/pytorch (官方 ROCm PyTorch 镜像, ROCm 7.2.4 / PyTorch 2.10.0)
# 用法: docker build -t <registry>/hami-lc-amd:v1 -f Dockerfile.amd .
#       docker push <registry>/hami-lc-amd:v1
# N3 拉取如遇 Docker Hub 403，可使用同 tag 的 SWR mirror:
#   swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/rocm/pytorch:rocm7.2.4_ubuntu24.04_py3.12_pytorch_release_2.10.0
FROM rocm/pytorch:rocm7.2.4_ubuntu24.04_py3.12_pytorch_release_2.10.0

# jupyterlab 作为 JupyterHub singleuser 入口; 鉴权边界 = hub proxy (AUP code-server 同款模式)
RUN pip install --no-cache-dir jupyterlab

CMD ["jupyter", "lab", "--ip=0.0.0.0", "--port=8888", "--no-browser", "--allow-root"]
