# hami-learning-cloud local deployment values (TEMPLATE).
# Copy to .env.local and fill in real values:
#   cp .env.local.example .env.local
# .env.local is gitignored (.env.*) and must NEVER be committed.
# Run ./scripts/render_local.sh after editing to regenerate:
#   - runtime/values.local.yaml   (helm overlay, hub node pinning)
#   - build/nfs-*.yaml            (NFS PV/PVC manifests)
#   - build/amd-time-slice-test.yaml

# Hub pod node pinning (kubernetes.io/hostname of the hub node)
HUB_NODE_HOSTNAME=

# NAS home share (server hostname + NFS export path)
NAS_SERVER=
NAS_HOME_EXPORT=

# AMD GPU node hostname (for the time-slice test pods)
AMD_GPU_NODE_HOSTNAME=

# k3s server IP (for join.sh: --server "$K3S_SERVER_IP")
K3S_SERVER_IP=
# K3S_TOKEN=             # optional; only needed for join.sh --token
