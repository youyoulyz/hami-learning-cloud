+type pluginConfig struct {
+	Version string `yaml:"version"`
+	Sharing struct {
+		TimeSlicing struct {
+			Enabled    bool `yaml:"enabled"`
+			SliceCount int  `yaml:"sliceCount"`
+		} `yaml:"timeSlicing"`
+	} `yaml:"sharing"`
+}
+
+func resolveSliceCount() int {
+	configPath := os.Getenv("CONFIG_FILE_PATH")
+	if configPath == "" {
+		configPath = "/etc/amdgpu-dp/config.yaml"
+	}
+
+	sliceCount := 1
+	if data, err := os.ReadFile(configPath); err == nil {
+		var cfg pluginConfig
+		if err := yaml.Unmarshal(data, &cfg); err != nil {
+			glog.Warningf("failed to parse device plugin config %s: %v", configPath, err)
+		} else if cfg.Sharing.TimeSlicing.Enabled && cfg.Sharing.TimeSlicing.SliceCount > 0 {
+			sliceCount = cfg.Sharing.TimeSlicing.SliceCount
+		}
+	}
+
+	if v, err := strconv.Atoi(os.Getenv("AMDGPU_DEVICE_MAX_PER_GPU")); err == nil && v > 0 {
+		sliceCount = v
+	}
+	if v, err := strconv.Atoi(os.Getenv("AMD_TIME_SLICE_COUNT")); err == nil && v > 0 {
+		sliceCount = v
+	}
+	if sliceCount < 1 {
+		sliceCount = 1
+	}
+
+	glog.Infof("AMD GPU device plugin time-slice count: %d", sliceCount)
+	return sliceCount
+}
+
